# Python environments and caches
.venv/
__pycache__/
*.pyc

# Local TrashNet dataset; keep only directory placeholders
data/*
!data/trashnet/
data/trashnet/*
!data/trashnet/raw/
data/trashnet/raw/*
!data/trashnet/raw/**/
!data/trashnet/raw/**/.gitkeep
