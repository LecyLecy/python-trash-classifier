# Downloaded dataset archives and extraction folders
dataset-resized.zip
data/dataset-resized.zip
dataset-resized/
data/dataset-resized/

# Keep portfolio evaluation artifacts, but not training logs
metrics/*
!metrics/metrics.json
!metrics/classification_report.json
!metrics/confusion_matrix.png
!metrics/train_log.csv

